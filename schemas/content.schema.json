{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORIONINSIST one-page family v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "template",
    "content",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "type": {
      "const": "one_page"
    },
    "template": {
      "enum": [
        "one_page_v1",
        "one_page_compact_v1"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "lead",
        "sections",
        "footer"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "footer": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "body"
            ],
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "page"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2
        },
        "page": {
          "const": "a4"
        },
        "font_family": {
          "type": "string",
          "minLength": 1,
          "description": "Optional per-document font override; must be installed in Typst."
        }
      }
    }
  }
}
